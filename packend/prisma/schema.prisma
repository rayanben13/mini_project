generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model daily_reminders {
  id            Int       @id @default(autoincrement())
  id_user       Int?
  id_file       Int?
  reminder_time DateTime? @db.Time(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  files         files?    @relation(fields: [id_file], references: [id_file], onDelete: Cascade, onUpdate: NoAction)
  users         users?    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
}

model file_reports {
  id_report  Int       @id @default(autoincrement())
  id_user    Int?
  id_file    Int?
  reason     String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  files      files?    @relation(fields: [id_file], references: [id_file], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model files {
  id_file          Int                @id @default(autoincrement())
  id_user          Int
  id_subject       Int
  title            String             @db.VarChar
  creation_year    String             @db.VarChar
  file_path        String
  file_hash        String             @db.VarChar
  type             String             @db.VarChar
  status           String?            @default("pending") @db.VarChar
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  daily_reminders  daily_reminders[]
  file_reports     file_reports[]
  subjects         subjects           @relation(fields: [id_subject], references: [id_subject], onDelete: Cascade, onUpdate: NoAction)
  users            users              @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
  interaction      interaction[]
  study_list_files study_list_files[]

  @@index([id_subject], map: "idx_files_subject")
  @@index([id_user], map: "idx_files_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model follows {
  follower_id                       Int
  following_id                      Int
  created_at                        DateTime? @default(now()) @db.Timestamp(6)
  users_follows_follower_idTousers  users     @relation("follows_follower_idTousers", fields: [follower_id], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
  users_follows_following_idTousers users     @relation("follows_following_idTousers", fields: [following_id], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_id, following_id])
  @@index([follower_id], map: "idx_following")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model interaction {
  id          Int          @id @default(autoincrement())
  id_user     Int?
  id_file     Int?
  id_stulist  Int?
  type        String?      @db.VarChar
  created_at  DateTime?    @default(now()) @db.Timestamp(6)
  files       files?       @relation(fields: [id_file], references: [id_file], onDelete: Cascade, onUpdate: NoAction)
  study_lists study_lists? @relation(fields: [id_stulist], references: [id_stulist], onDelete: Cascade, onUpdate: NoAction)
  users       users?       @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_user, id_file])
  @@unique([id_user, id_stulist])
  @@index([id_file], map: "idx_interaction_file")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notifications {
  id_notification Int       @id @default(autoincrement())
  id_user         Int?
  message         String
  related_id      Int?
  related_type    String?   @db.VarChar
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users?    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_user], map: "idx_notifications_user")
}

model study_list_files {
  id_stulist  Int
  id_file     Int
  files       files       @relation(fields: [id_file], references: [id_file], onDelete: Cascade, onUpdate: NoAction)
  study_lists study_lists @relation(fields: [id_stulist], references: [id_stulist], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_stulist, id_file])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model study_lists {
  id_stulist       Int                @id @default(autoincrement())
  id_user          Int
  name             String             @db.VarChar
  privacy          String?            @default("public") @db.VarChar
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  interaction      interaction[]
  study_list_files study_list_files[]
  users            users              @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subjects {
  id_subject     Int           @id @default(autoincrement())
  id_university  Int?
  academic_year  String        @db.VarChar
  major          String        @db.VarChar
  specialization String?       @db.VarChar
  course         String        @db.VarChar
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  files          files[]
  universities   universities? @relation(fields: [id_university], references: [id_university], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_university, academic_year, major, specialization, course])
}

model universities {
  id_university    Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar
  web_site         String?            @db.VarChar
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  subjects         subjects[]
  user_information user_information[]
}

model university_majors {
  id_m           Int       @id @default(autoincrement())
  major          String?   @db.VarChar
  specialization String?   @db.VarChar
  course         String?   @db.VarChar
  created_at     DateTime? @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_information {
  id_user        Int          @id
  id_university  Int
  academic_year  String       @db.VarChar
  major          String       @db.VarChar
  specialization String?      @db.VarChar
  created_at     DateTime?    @default(now()) @db.Timestamp(6)
  universities   universities @relation(fields: [id_university], references: [id_university], onDelete: Cascade, onUpdate: NoAction)
  users          users        @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id_user                             Int               @id @default(autoincrement())
  username                            String            @unique @db.VarChar
  fullname                            String            @db.VarChar
  img_user                            String?
  email                               String            @unique @db.VarChar
  password                            String            @db.VarChar
  is_active                           Boolean?          @default(false)
  role                                String?           @default("guest") @db.VarChar
  level                               Int?              @default(1)
  created_at                          DateTime?         @default(now()) @db.Timestamp(6)
  daily_reminders                     daily_reminders[]
  file_reports                        file_reports[]
  files                               files[]
  follows_follows_follower_idTousers  follows[]         @relation("follows_follower_idTousers")
  follows_follows_following_idTousers follows[]         @relation("follows_following_idTousers")
  interaction                         interaction[]
  notifications                       notifications[]
  study_lists                         study_lists[]
  user_information                    user_information?
}
