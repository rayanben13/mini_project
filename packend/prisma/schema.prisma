generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model daily_reminders {
  id            Int          @id @default(autoincrement())
  id_user       Int?
  id_stuList    Int?
  reminder_time DateTime?    
  created_at    DateTime?    @default(now()) @db.Timestamp(6)
  study_lists   study_lists? @relation(fields: [id_stuList], references: [id_stuList], onDelete: Cascade, onUpdate: NoAction)
  users         users?       @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_stuList], map: "idx_reminders_list")
  @@index([reminder_time], map: "idx_reminders_time")
  @@index([id_user], map: "idx_reminders_user")
}

enum ReportStatus {
  pending
  reviewed
  ignored
}
enum ReportAction {
  none
  blocked
  removed
}

model file_reports {
  id_report  Int       @id @default(autoincrement())
  id_user    Int?
  id_file    Int?
  reason     String
  details    String?
  status     ReportStatus @default(pending)
  action     ReportAction @default(none)
  handled_at DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  files      files?    @relation(fields: [id_file], references: [id_file], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_file], map: "idx_reports_file")
  @@index([status], map: "idx_reports_status")
  @@index([id_user], map: "idx_reports_user")
}

enum FileType {
  TD
  TP
  COURS
  EF
  CC
  RESUME
  OTHER
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.


enum FileStatus {
  pending
  accepted
  rejected
}

model files {
  id_file          Int                @id @default(autoincrement())
  id_user          Int
  id_subject       Int
  title            String             @db.VarChar
  creation_year    String             @db.VarChar
  file_path        String
  file_hash        String?             @db.VarChar
  type             FileType
  status           FileStatus         @default(pending)
  reason_rejected  String?            @db.VarChar
  approved_at      DateTime?          @db.Timestamp(6)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  file_reports     file_reports[]
  subjects         subjects           @relation(fields: [id_subject], references: [id_subject], onDelete: Cascade, onUpdate: NoAction)
  users            users              @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
  files_likes      files_likes[]
  study_list_files study_list_files[]

  @@index([id_subject], map: "idx_files_subject")
  @@index([id_user], map: "idx_files_user")
  @@index([creation_year], map: "idx_files_creation_year")
  @@index([file_hash], map: "idx_files_hash")
  @@index([status], map: "idx_files_status")
  @@index([type], map: "idx_files_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model follows {
  follower_id                       Int
  following_id                      Int
  created_at                        DateTime? @default(now()) @db.Timestamp(6)
  users_follows_follower_idTousers  users     @relation("follows_follower_idTousers", fields: [follower_id], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
  users_follows_following_idTousers users     @relation("follows_following_idTousers", fields: [following_id], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_id, following_id])
  @@index([follower_id], map: "idx_follows_follower")
  @@index([following_id], map: "idx_follows_following")
}


enum FileLikeType {
  LIKE
  DISLIKE
}
model files_likes {
  id        Int   @id @default(autoincrement())
  id_user   Int
  id_file   Int
  type      FileLikeType
  created_at DateTime @default(now())

  files files @relation(fields: [id_file], references: [id_file], onDelete: Cascade)
  users users @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@unique([id_user, id_file])
  @@index([id_file])
  @@index([id_user])
}


model studyList_likes {
  id         Int   @id @default(autoincrement())
  id_user    Int
  id_stuList Int
  created_at DateTime @default(now())

  study_lists study_lists @relation(fields: [id_stuList], references: [id_stuList], onDelete: Cascade)
  users users @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@unique([id_user, id_stuList])
  @@index([id_user])
  @@index([id_stuList])
}
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
enum RelatedType {
  user
  file
  study_list
}

model notifications {
  id_notification Int       @id @default(autoincrement())
  id_user         Int?
  message         String
  related_id      Int?
  related_type    RelatedType
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  users           users?    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_user], map: "idx_notifications_user")
  @@index([is_read], map: "idx_notifications_read")
  @@index([related_type], map: "idx_notifications_type")
}

model study_list_files {
  id_stuList  Int
  id_file     Int
  files       files       @relation(fields: [id_file], references: [id_file], onDelete: Cascade, onUpdate: NoAction)
  study_lists study_lists @relation(fields: [id_stuList], references: [id_stuList], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_stuList, id_file])
  @@index([id_file], map: "idx_sl_files_file")
  @@index([id_stuList], map: "idx_sl_files_list")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
enum Privacy {
  public
  private
}

model study_lists {
  id_stuList        Int                 @id @default(autoincrement())
  id_user           Int
  id_subject        Int
  name              String              @db.VarChar
  description       String              @db.VarChar
  privacy           Privacy             @default(public)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  daily_reminders   daily_reminders[]
  studyList_likes   studyList_likes[]
  saved_study_lists saved_study_lists[]
  study_list_files  study_list_files[]
  subjects          subjects            @relation(fields: [id_subject], references: [id_subject], onDelete: Cascade, onUpdate: NoAction)
  users             users               @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@index([privacy], map: "idx_study_lists_privacy")
  @@index([id_subject], map: "idx_study_lists_subject")
  @@index([id_user], map: "idx_study_lists_user")
}
enum AcademicYear {
 L1
 L2
 L3
 M1
 M2
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subjects {
  id_subject     Int           @id @default(autoincrement())
  university     String?   @db.VarChar(255)
  academic_year  AcademicYear        
  major          String        @db.VarChar
  specialization String?       @db.VarChar
  course         String        @db.VarChar
  course_description String?   @db.VarChar
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  files          files[]
  study_lists    study_lists[]

  @@index([course], map: "idx_subjects_course")
  @@index([major], map: "idx_subjects_major")
  @@index([academic_year], map: "idx_subjects_year")
}

model university_majors {
  id_M           Int       @id @default(autoincrement())
  course         String?   @db.VarChar
  course_description String?   @db.VarChar
  major          String?   @db.VarChar
  academic_year  AcademicYear    
  specialization String?   @db.VarChar

  created_at     DateTime? @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_information {
  id_user        Int       @id
  major          String    @db.VarChar
  academic_year  AcademicYear
  specialization String?   @db.VarChar
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  university     String?   @db.VarChar(255)
  users          users     @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@index([major], map: "idx_user_information_major")
  @@index([academic_year], map: "idx_user_information_year")
}

enum Roles {
  user
  admin
  guest
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id_user                             Int                 @id @default(autoincrement())
  username                            String              @unique @db.VarChar
  fullname                            String              @db.VarChar
  img_user                            String?
  email                               String              @unique @db.VarChar
  password                            String              @db.VarChar
  is_active                           Boolean?            @default(false)
  role                                Roles               @default(guest)
  level                               Int?                @default(1)
  created_at                          DateTime?           @default(now()) @db.Timestamp(6)
  daily_reminders                     daily_reminders[]
  file_reports                        file_reports[]
  files                               files[]
  follows_follows_follower_idTousers  follows[]           @relation("follows_follower_idTousers")
  follows_follows_following_idTousers follows[]           @relation("follows_following_idTousers")
  files_likes                         files_likes[]
  studyList_likes                     studyList_likes[]
  notifications                       notifications[]
  saved_study_lists                   saved_study_lists[]
  study_lists                         study_lists[]
  user_information                    user_information?

  @@index([email], map: "idx_users_email")
  @@index([role], map: "idx_users_role")
  @@index([username], map: "idx_users_username")
}

model saved_study_lists {
  id_user     Int
  id_stuList  Int
  created_at  DateTime?   @default(now()) @db.Timestamp(6)
  study_lists study_lists @relation(fields: [id_stuList], references: [id_stuList], onDelete: Cascade, onUpdate: NoAction)
  users       users       @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_user, id_stuList])
  @@index([id_stuList], map: "idx_saved_list")
  @@index([id_user], map: "idx_saved_user")
}
